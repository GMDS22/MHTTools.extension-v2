<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Fire &amp; Smoke Damper Placement" Height="620" Width="700"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1177BB"/><SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/><SolidColorBrush x:Key="InputBrush" Color="#232327"/><SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/><SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/><SolidColorBrush x:Key="AccentBrush" Color="#F2B134"/><SolidColorBrush x:Key="DangerBrush" Color="#CC4B4B"/>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource SecondaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/><Setter Property="IsEditable" Value="False"/><Setter Property="TextSearch.TextPath" Value="Name"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/><Grid Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="8,2,6,2" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}"/><Border Grid.Column="1" Background="#2B2B31" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False"><Path Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#E8E8E8" Data="M 0 0 L 5 5 L 10 0 Z"/></Border><ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Background="Transparent" BorderBrush="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Padding" Value="6,4"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#232327"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8E8"/></Style>
    </Window.Resources>
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Quick Fire / Smoke Damper Placement" FontSize="18" FontWeight="Bold"/><TextBlock Text="Select duct targets first. Only those ducts are checked against auto-detected rated walls." Foreground="#8A8A9A" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel>
        <GroupBox Grid.Row="1" Header="Damper duct accessory family" Margin="0,0,0,10" Foreground="#E8E8E8"><StackPanel Margin="8"><TextBlock Text="Duct accessory family"/><ComboBox x:Name="family_box" DisplayMemberPath="Name" Background="{StaticResource InputBrush}" Foreground="#E8E8E8" TextSearch.TextPath="Name" Margin="0,2,0,8"/><TextBlock Text="Family type / symbol"/><ComboBox x:Name="symbol_box" DisplayMemberPath="Name" Background="{StaticResource InputBrush}" Foreground="#E8E8E8" TextSearch.TextPath="Name"/></StackPanel></GroupBox>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6"><Button x:Name="refresh_button" Content="Refresh wall scan"/><Button x:Name="select_ducts_button" Content="Pick duct targets..."/><Button x:Name="clear_ducts_button" Content="Clear targets"/><TextBlock x:Name="status_text" Foreground="#8A8A9A" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Margin="12,0,0,0"/></WrapPanel>
        <GroupBox Grid.Row="3" Header="Auto-detected rated walls" Foreground="#E8E8E8"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Top" Text="Walls are classified from explicit NWB_Material / NWB_MATERIAL values in this active view and visible links. All listed walls are included automatically." Foreground="#8A8A9A" TextWrapping="Wrap" Margin="0,0,0,6"/><TreeView x:Name="wall_families_box"><TreeView.Resources><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Background" Value="#232327"/></Style></TreeView.Resources><TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding TypeNames}"><TextBlock Text="{Binding DisplayName}" Foreground="#E8E8E8" FontWeight="SemiBold" Margin="2,3" TextWrapping="Wrap"/><HierarchicalDataTemplate.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#C8CBD2" Margin="6,2" TextWrapping="Wrap"/></DataTemplate></HierarchicalDataTemplate.ItemTemplate></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></DockPanel></GroupBox>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="progress_text" Grid.ColumnSpan="2" Foreground="#E8E8E8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5"/><ProgressBar x:Name="progress_bar" Grid.Row="1" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,10,0"/><CheckBox x:Name="isolate_box" Grid.Row="1" Grid.Column="1" Content="Isolate placed dampers, host ducts and host walls" IsChecked="True" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,10,0"/><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button x:Name="cancel_button" Content="Cancel"/><Button x:Name="place_button" Content="Place Dampers" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
    </Grid>
</Window>
