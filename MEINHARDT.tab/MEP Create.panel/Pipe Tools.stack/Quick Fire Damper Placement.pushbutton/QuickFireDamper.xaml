<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Fire &amp; Smoke Damper Placement" Height="620" Width="520"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#E8E8E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1177BB"/><SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/><SolidColorBrush x:Key="InputBrush" Color="#232327"/><SolidColorBrush x:Key="SurfaceBrush" Color="#232327"/><SolidColorBrush x:Key="SecondaryBrush" Color="#1FA6A6"/><SolidColorBrush x:Key="AccentBrush" Color="#F2B134"/><SolidColorBrush x:Key="DangerBrush" Color="#CC4B4B"/>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource SecondaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="6"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#E8E8E8"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#232327"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8E8"/></Style>
    </Window.Resources>
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Quick Fire / Smoke Damper Placement" FontSize="18" FontWeight="Bold"/><TextBlock Text="Uses only the wall types selected below. Links can be selected when their architecture is loaded." Foreground="#8A8A9A" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel>
        <GroupBox Grid.Row="1" Header="Damper family and symbol" Margin="0,0,0,10" Foreground="#E8E8E8"><StackPanel Margin="8"><TextBlock Text="Family"/><ComboBox x:Name="family_box" Margin="0,2,0,8"/><TextBlock Text="Symbol"/><ComboBox x:Name="symbol_box"/></StackPanel></GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6"><Button x:Name="select_all_button" Content="Select all"/><Button x:Name="clear_button" Content="Clear"/><Button x:Name="refresh_button" Content="Refresh wall types"/></StackPanel>
        <GroupBox Grid.Row="3" Header="Wall types used in the active view" Foreground="#E8E8E8"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Top" Text="Use Ctrl or Shift to select multiple wall types." Foreground="#8A8A9A" Margin="0,0,0,6"/><ListBox x:Name="wall_types_box" SelectionMode="Extended"/></DockPanel></GroupBox>
        <DockPanel Grid.Row="4" Margin="0,10,0,0"><TextBlock x:Name="status_text" Foreground="#F2B134" VerticalAlignment="Center" TextWrapping="Wrap" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="cancel_button" Content="Cancel"/><Button x:Name="place_button" Content="Place Dampers" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
    </Grid>
</Window>
